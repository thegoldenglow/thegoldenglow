# Frontend Environment Variables
# Copy this file to .env or .env.local and fill in your values

# Supabase Configuration (Required for full functionality)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Telegram Bot Configuration (Required for Telegram authentication)
VITE_TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Telegram Membership Gate (Optional)
# Set the channel username or numeric ID the user must join
TELEGRAM_REQUIRED_CHANNEL=@GoldenGlowGlobal
# TELEGRAM_REQUIRED_CHANNEL_ID=-1001234567890
# If Telegram returns "member list is inaccessible" and you cannot make the bot an admin yet,
# you can temporarily skip membership verification by setting this to true.
# WARNING: Enabling skip allows everyone to pass the gate.
TELEGRAM_SKIP_MEMBERSHIP_CHECK=false
VITE_TELEGRAM_SKIP_MEMBERSHIP_CHECK=false

# WalletConnect Configuration (Optional, for Web3 features)
VITE_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id-here

# Backend Environment Variables (for server.js)
# These are used when running the backend server

# Telegram Bot Token for server-side validation
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Supabase Service Role Key (for database migrations and admin operations)
# IMPORTANT: Never expose this to the client side
VITE_SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional: Secret token to verify Telegram webhook requests
# Set the same value when calling setWebhook via secret_token parameter
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-long-string
