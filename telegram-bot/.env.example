# Telegram Bot - Local Environment Example
# Copy to .env and fill in values

# Required
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Channel Verification (optional but recommended)
TELEGRAM_REQUIRED_CHANNEL=@GoldenGlowGlobal
# TELEGRAM_REQUIRED_CHANNEL_ID=-1001234567890
TELEGRAM_SKIP_MEMBERSHIP_CHECK=false

# Optional
TELEGRAM_BOT_USERNAME=TheGoldenGlow_bot
VITE_APP_URL=https://lambent-pithivier-68ddb6.netlify.app
